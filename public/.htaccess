<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Forcer le HTTPS globalement
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 2. IGNORER le dossier gestion (laisser le symlink travailler)
    RewriteCond %{REQUEST_URI} ^/gestion [NC]
    RewriteRule .* - [L]

    # 3. Règle standard pour le reste du site (si tu as un site à la racine)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>